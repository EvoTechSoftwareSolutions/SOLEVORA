generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model addresses {
  id         Int      @id @default(autoincrement())
  userId     Int
  title      String
  name       String
  street     String?
  country    String?
  phone      String?
  isDefault  Boolean  @default(false)
  icon       String   @default(dbgenerated("(home)"))
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  city       String?
  postalCode String?
  users      users    @relation(fields: [userId], references: [id])

  @@index([userId], map: "addresses_userId_fkey")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.Text
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  products    Product[]
}

model contacts {
  id        BigInt   @id @default(autoincrement())
  name      String
  phone     String?
  email     String
  subject   String?
  message   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime
  isRead    Boolean  @default(false)
}

model order_items {
  id                BigInt   @id @default(autoincrement())
  quantity          Int
  price_at_purchase Decimal  @db.Decimal(10, 2)
  orderId           BigInt
  productId         Int
  size              String?
  orders            orders   @relation(fields: [orderId], references: [id])
  products          Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "order_items_orderId_fkey")
  @@index([productId], map: "order_items_productId_fkey")
}

model orders {
  id                 BigInt                @id @default(autoincrement())
  total_amount       Decimal               @db.Decimal(10, 2)
  status             orders_status         @default(dbgenerated("(pending)"))
  shipping_address   String?               @db.Text
  contact_number     String?
  email              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime
  userId             Int?
  tracking_number    String?
  carrier            String?
  payment_method     orders_payment_method @default(dbgenerated("(online)"))
  payment_status     orders_payment_status @default(dbgenerated("(pending)"))
  estimated_delivery DateTime?
  actual_delivery    DateTime?
  order_items        order_items[]
  users              users?                @relation(fields: [userId], references: [id])

  @@index([userId], map: "orders_userId_fkey")
}

model product_batches {
  id                BigInt   @id @default(autoincrement())
  productId         Int
  quantity          Int      @default(0)
  original_quantity Int
  cost_price        Decimal? @db.Decimal(10, 2)
  selling_price     Decimal  @db.Decimal(10, 2)
  batch_date        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  products          Product @relation(fields: [productId], references: [id])

  @@index([productId], map: "product_batches_productId_fkey")
}

model Product {
  id              Int               @id @default(autoincrement())
  name            String
  description     String?           @db.Text
  price           Decimal           @db.Decimal(10, 2)
  discountPrice   Decimal?          @db.Decimal(10, 2)
  slug            String            @unique
  gender          ProductGender     @default(ALL)
  categoryId      Int
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  category        Category          @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  stocks          ProductStock[]
  order_items     order_items[]
  product_batches product_batches[]
  reviews         reviews[]
  wishlists       wishlists[]
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  url       String
  productId Int

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductStock {
  id        Int    @id @default(autoincrement())
  productId Int
  size      String
  costPrice Decimal @db.Decimal(10, 2)
  quantity  Int

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model promo_codes {
  id             Int                      @id @default(autoincrement())
  code           String                   @unique
  discountType   promo_codes_discountType @default(dbgenerated("(percentage)"))
  discountValue  Decimal                  @db.Decimal(10, 2)
  minOrderAmount Decimal                  @default(0.00) @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int                      @default(0)
  expiresAt      DateTime?
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime
}

model reviews {
  id        BigInt   @id @default(autoincrement())
  rating    Int
  comment   String   @db.Text
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  products  Product @relation(fields: [productId], references: [id])
  users     users    @relation(fields: [userId], references: [id])

  @@index([productId], map: "reviews_productId_fkey")
  @@index([userId], map: "reviews_userId_fkey")
}

model subscribers {
  id        Int      @id @default(autoincrement())
  email     String   @unique(map: "email")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model users {
  id                Int         @id @default(autoincrement())
  name              String
  email             String      @unique(map: "email")
  password          String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime
  phone             String?
  location          String?
  newsletter        Boolean     @default(true)
  pushNotifications Boolean     @default(true)
  usageReports      Boolean     @default(false)
  role              users_role  @default(dbgenerated("(customer)"))
  lastLogin         DateTime?
  streetAddress     String?
  city              String?
  postalCode        String?
  country           String?
  resetToken        String?
  resetTokenExpires DateTime?
  addresses         addresses[]
  orders            orders[]
  reviews           reviews[]
  wishlists         wishlists[]
}

model wishlists {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  products  Product @relation(fields: [productId], references: [id])
  users     users    @relation(fields: [userId], references: [id])

  @@index([productId], map: "wishlists_productId_fkey")
  @@index([userId], map: "wishlists_userId_fkey")
}

enum orders_status {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
}

enum promo_codes_discountType {
  percentage
  fixed
}

enum orders_payment_method {
  online
  cod
}

enum users_role {
  admin
  store_manager
  customer
}

enum orders_payment_status {
  pending
  paid
  failed
}

enum ProductGender {
  MEN
  WOMEN
  KIDS
  ALL
}
